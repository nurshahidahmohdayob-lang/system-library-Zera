# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Set to "true" to point the client at the local Firebase Emulator Suite
# (Firestore :8080, Auth :9099) instead of the live production database.
# Start the emulators with `npm run emulators`, then run `npm run dev:emulator`
# (which sets this automatically). Dev-only; ignored in production builds.
VITE_USE_EMULATOR=

# STUDENT REGISTRY REST API KEY
# Pre-injects the pre-authorized school administrative token code for syncing student records
VITE_STUDENT_API_KEY=

# ─── Commun Connected-Systems SSO ────────────────────────────────────────────
# Browser SSO handoff (/sso/callback) + back-channel reads. Obtain client_id and
# machine token once from School Admin → Connected Systems (token shown only once).
COMMUN_SUBDOMAIN=         # base URL for JWKS + back-channel, e.g. https://zera.commun.cloud
COMMUN_ISSUER=           # expected `iss` claim (the school app URL)
COMMUN_CLIENT_ID=        # expected `aud` claim (your registered client_id)
COMMUN_MACHINE_TOKEN=    # Bearer for /api/v1/userinfo/{sub} and bulk reads (secret)
COMMUN_LOGIN_URL=        # optional: where "Sign in with Commun" sends users (defaults to COMMUN_SUBDOMAIN)

# Firebase Admin SDK credentials (mints custom tokens for the SSO bridge).
# Local: path to a service-account JSON. Cloud Run: leave unset to use ADC.
GOOGLE_APPLICATION_CREDENTIALS=

# Dev-only: enable /sso/dev-login to exercise the bridge without Commun.
# Never set in production. Requires Admin SDK credentials above.
ALLOW_DEV_SSO=

