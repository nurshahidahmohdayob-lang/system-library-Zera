rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- GLOBAL HELPERS ---
    function isSignedIn() { return request.auth != null; }
    function isValidId(id) { return id is string && id.size() <= 128; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    
    function isBootstrappedAdmin() {
      return isSignedIn() && 
             'email' in request.auth.token && (
               request.auth.token.email.lower() == 'nurshahidahmohdayob@gmail.com' ||
               request.auth.token.email.lower() == 'shahidah.a@zera.edu.my'
             );
    }
    
    function isDbAdmin() {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'admin';
    }
    
    function isAdmin() { 
      return isBootstrappedAdmin() || isDbAdmin();
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // SSO-provisioned (Commun) users carry an `sso:true` custom claim. Their role
    // is set server-side; they must never be able to self-assign the admin role.
    function isSsoUser() {
      return isSignedIn() && request.auth.token.get('sso', false) == true;
    }

    // --- VALIDATION HELPERS ---

    function isValidUser(data) {
      return data.keys().hasAll(['name', 'role']) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.role in ['student', 'teacher', 'admin'] &&
             (!('email' in data) || (data.email is string && data.email.size() <= 100)) &&
             (!('status' in data) || (data.status is string && data.status.size() <= 50)) &&
             (!('createdAt' in data) || (data.createdAt is string || data.createdAt is timestamp)) &&
             (!('updatedAt' in data) || (data.updatedAt is string || data.updatedAt is timestamp)) &&
             (!('grade' in data) || (data.grade is string && data.grade.size() <= 50)) &&
             (!('department' in data) || (data.department is string && data.department.size() <= 50)) &&
             (!('studentId' in data) || (data.studentId is string && data.studentId.size() <= 50)) &&
             (!('phoneNumber' in data) || (data.phoneNumber is string && data.phoneNumber.size() <= 50)) &&
             (!('activeLoansCount' in data) || (data.activeLoansCount is int || data.activeLoansCount is float || data.activeLoansCount is number));
    }

    function isValidBook(data) {
      return data.keys().hasAll(['title', 'author']) &&
             data.title is string && data.title.size() <= 200 &&
             data.author is string && data.author.size() <= 100 &&
             (!('isbn' in data) || (data.isbn is string && data.isbn.size() <= 20)) &&
             (!('summary' in data) || (data.summary is string && data.summary.size() <= 5000)) &&
             (!('coverUrl' in data) || (data.coverUrl is string && data.coverUrl.size() <= 1000)) &&
             (!('category' in data) || (data.category is string && data.category.size() <= 100)) &&
             (!('publishedYear' in data) || (data.publishedYear is int || data.publishedYear is float || data.publishedYear is number)) &&
             (!('totalCopies' in data) || (data.totalCopies is int || data.totalCopies is float || data.totalCopies is number)) &&
             (!('availableCopies' in data) || (data.availableCopies is int || data.availableCopies is float || data.availableCopies is number)) &&
             (!('status' in data) || (data.status in ['available', 'unavailable', 'archived', 'lost', 'damaged', 'active'])) &&
             (!('createdAt' in data) || (data.createdAt is string || data.createdAt is timestamp)) &&
             (!('updatedAt' in data) || (data.updatedAt is string || data.updatedAt is timestamp)) &&
             (!('barcode' in data) || (data.barcode is string && data.barcode.size() <= 50));
    }

    function isValidLoan(data) {
      return data.keys().hasAll(['bookId', 'userId', 'checkoutDate', 'dueDate', 'status']) &&
             isValidId(data.bookId) &&
             isValidId(data.userId) &&
             ((data.checkoutDate is string && data.checkoutDate.size() <= 100) || data.checkoutDate is timestamp) &&
             ((data.dueDate is string && data.dueDate.size() <= 100) || data.dueDate is timestamp) &&
             (!('returnDate' in data) || ((data.returnDate is string && data.returnDate.size() <= 100) || data.returnDate is timestamp)) &&
             data.status in ['active', 'returned', 'overdue', 'archived'] &&
             (!('bookTitle' in data) || (data.bookTitle is string && data.bookTitle.size() <= 200)) &&
             (!('userName' in data) || (data.userName is string && data.userName.size() <= 100)) &&
             (!('copyId' in data) || isValidId(data.copyId));
    }

    function isValidAcquisition(data) {
      return data.keys().hasAll(['title', 'requestedBy', 'status']) &&
             data.title is string && data.title.size() <= 200 &&
             (!('author' in data) || (data.author is string && data.author.size() <= 100)) &&
             (!('isbn' in data) || (data.isbn is string && data.isbn.size() <= 20)) &&
             isValidId(data.requestedBy) &&
             data.status in ['pending', 'approved', 'ordered', 'received'] &&
             (!('price' in data) || (data.price is int || data.price is float || data.price is number)) &&
             (!('priority' in data) || (data.priority in ['high', 'medium', 'low'])) &&
             (!('createdAt' in data) || (data.createdAt is string || data.createdAt is timestamp)) &&
             (!('updatedAt' in data) || (data.updatedAt is string || data.updatedAt is timestamp));
    }

    function isValidHold(data) {
      return data.keys().hasAll(['bookId', 'userId', 'status', 'requestedAt']) &&
             isValidId(data.bookId) &&
             isValidId(data.userId) &&
             data.status in ['pending', 'ready', 'fulfilled', 'cancelled', 'rejected'] &&
             data.requestedAt is string && data.requestedAt.size() <= 100 &&
             (!('bookTitle' in data) || (data.bookTitle is string && data.bookTitle.size() <= 200)) &&
             (!('bookAuthor' in data) || (data.bookAuthor is string && data.bookAuthor.size() <= 200)) &&
             (!('bookCoverUrl' in data) || (data.bookCoverUrl is string && data.bookCoverUrl.size() <= 1000)) &&
             (!('userName' in data) || (data.userName is string && data.userName.size() <= 100)) &&
             (!('userEmail' in data) || (data.userEmail is string && data.userEmail.size() <= 100)) &&
             (!('userRole' in data) || (data.userRole is string && data.userRole.size() <= 50)) &&
             (!('note' in data) || (data.note is string && data.note.size() <= 500));
    }

    // --- COLLECTION RULES ---

    // 0. Connection Verification
    match /test/connection {
      allow read: if true;
    }

    // 1. Users
    //  - Admins may write any profile (librarian management, sync, SDK provisioning).
    //  - A user may write only their OWN profile, and an SSO user may never set role=admin.
    match /users/{userId} {
      allow read: if true; // Allows public lookups in Member Portal
      allow create, update: if isAdmin() ||
        (isOwner(userId) && isValidUser(incoming()) && !(isSsoUser() && incoming().role == 'admin'));
      allow delete: if isAdmin();
    }

    // 2. Books — public read; only admins (librarians) mutate the catalog.
    match /books/{bookId} {
      allow read: if true; // Public catalog search
      allow write: if isAdmin();
    }

    // 3. Loans — public read for the borrowing portal; only admins create/return.
    match /loans/{loanId} {
      allow read: if true; // Public borrowing portal query list of loans
      allow write: if isAdmin();
    }

    // 4. Acquisitions — any authenticated user may request; only admins manage.
    match /acquisitions/{acquisitionId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidAcquisition(incoming());
      allow update, delete: if isAdmin();
    }

    // 5. Inventory Sessions — admin only.
    match /inventory_sessions/{sessionId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // 6. Copies — public read; only admins mutate.
    match /copies/{copyId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 7. Holds — member reservation requests.
    //  - A member reads only their own holds; admins (librarians) read all.
    //  - A member may create only their OWN pending hold.
    //  - A member may only cancel their own hold; admins manage the lifecycle.
    match /holds/{holdId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn()
                       && incoming().userId == request.auth.uid
                       && incoming().status == 'pending'
                       && isValidHold(incoming());
      allow update: if isAdmin()
                       || (isOwner(existing().userId) && incoming().status == 'cancelled');
      allow delete: if isAdmin();
    }

    // 7. Counters (Barcode sequence counters)
    match /counters/{counterId} {
      allow read, write: if true;
    }

  }
}
